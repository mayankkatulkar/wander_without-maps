{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker name — this also becomes your free *.workers.dev subdomain,
  // e.g. wander-without-maps.<your-account>.workers.dev
  "name": "wander-without-maps",

  "main": ".open-next/worker.js",

  // nodejs_compat is required by the OpenNext adapter.
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],

  // Prerendered pages, CSS, JS and images are served as static assets
  // straight from Cloudflare's edge; only dynamic routes hit the Worker.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    // Overridden per environment. Must match your real domain in production,
    // because it is what canonical URLs, OG tags and the sitemap are built from.
    "NEXT_PUBLIC_SITE_URL": "https://wanderwithoutmaps.com"
  }

  // Adding ISR later? You will also need an R2 bucket and a self-reference
  // service binding here. See open-next.config.ts.
}
